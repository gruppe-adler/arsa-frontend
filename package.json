{
    "name": "arsa-frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview",
        "openapi:generate": "pnpm exec openapi-ts -i openapi.json -o src/client",
        "docker": "docker build --no-cache -t arsa-frontend .",
        "docker-run": "docker run -d --rm -p 80:80 --name arsa-frontend arsa-frontend"
    },
    "dependencies": {
        "@openapitools/openapi-generator-cli": "^2.31.1",
        "@vueuse/core": "^11.1.0",
        "ajv": "^8.17.1",
        "ajv-formats": "^3.0.1",
        "ajv-keywords": "^5.1.0",
        "fluent-json-schema": "^5.0.0",
        "is-ip": "^5.0.1",
        "pinia": "^2.2.2",
        "pretty-bytes": "^7.1.0",
        "uuid": "^10.0.0",
        "vue": "^3.4.37",
        "vue-router": "^4.4.5"
    },
    "devDependencies": {
        "@hey-api/openapi-ts": "0.95.0",
        "@types/uuid": "^10.0.0",
        "@vitejs/plugin-vue": "^5.1.2",
        "orval": "^8.7.0",
        "prettier": "^3.8.2",
        "typescript": "^5.5.3",
        "vite": "^5.4.1",
        "vue-tsc": "^2.0.29"
    }
}
