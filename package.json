    "dependencies": {
        "@vue/devtools-api": "^8.2.1",
        "@vueuse/core": "^15.0.0",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "ajv-keywords": "^5.1.0",
        "fluent-json-schema": "^5.0.0",
        "is-ip": "^5.0.1",
        "pinia": "^4.1.0",
        "pretty-bytes": "^7.2.0",
        "reka-ui": "^2.11.0",
        "uuid": "^14.0.3",
        "vue": "^3.5.46",
        "vue-router": "^4.6.5"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.11",
        "@vitest/eslint-plugin": "^1.6.28",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-vue": "^10.12.1",
        "jiti": "^2.7.0",
        "orval": "^8.49.0",
        "prettier": "^3.10.1",
        "typescript": "^6.0.3",
        "vite": "^8.4.0",
        "vue-tsc": "^3.3.14"
