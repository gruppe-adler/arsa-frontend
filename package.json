{
    "name": "arsa-frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
